  items    CastingJobItem[]
  receipts CastingJobReceipt[]

  @@unique([jobFy, jobNo])
  @@index([status])
  @@index([workerType])
  @@index([jobFy])
  @@index([issueDate])
  @@index([supplierId])
  @@index([workerNameSnapshot])
  @@map("casting_jobs")
}

model CastingJobItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castingJobId String
  castingJob   CastingJob @relation(fields: [castingJobId], references: [id], onDelete: Cascade)

  inputRawMaterialId String
  inputRawMaterial   RawMaterial @relation("CastingInputRawMaterial", fields: [inputRawMaterialId], references: [id], onDelete: Restrict)

  outputCastingId String
  outputCasting   CastingMaster @relation(fields: [outputCastingId], references: [id], onDelete: Restrict)

  inputTitle  String
  outputTitle String
  inputUnit   String?
  outputUnit  String?

  issuedQty      Int     @default(0)
  issuedWeightKg Decimal @default(0) @db.Decimal(14, 3)

  expectedOutputQty      Int?
  expectedOutputWeightKg Decimal? @db.Decimal(14, 3)

  receivedQty      Int     @default(0)
  receivedWeightKg Decimal @default(0) @db.Decimal(14, 3)
  pendingWeightKg  Decimal @default(0) @db.Decimal(14, 3)

  sortOrder Int @default(0)

  receiptItems CastingJobReceiptItem[]

  @@index([castingJobId, sortOrder])
  @@index([inputRawMaterialId])
  @@index([outputCastingId])
  @@map("casting_job_items")
}

model CastingJobReceipt {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castingJobId String
  castingJob   CastingJob @relation(fields: [castingJobId], references: [id], onDelete: Cascade)

  receiptNo  Int
  receivedAt DateTime @default(now())

  receivedByNameSnapshot String?
  remarks                String?

  items CastingJobReceiptItem[]

  @@unique([castingJobId, receiptNo])
  @@index([castingJobId, receivedAt])
  @@map("casting_job_receipts")
}

model CastingJobReceiptItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castingJobReceiptId String
  castingJobReceipt   CastingJobReceipt @relation(fields: [castingJobReceiptId], references: [id], onDelete: Cascade)

  castingJobItemId String
  castingJobItem   CastingJobItem @relation(fields: [castingJobItemId], references: [id], onDelete: Cascade)

  receivedQty      Int     @default(0)
  receivedWeightKg Decimal @default(0) @db.Decimal(14, 3)

  sortOrder Int @default(0)

  @@index([castingJobReceiptId, sortOrder])
  @@index([castingJobItemId])
  @@map("casting_job_receipt_items")
}

model StockAdjustment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjustNo Int
  adjustFy String

  status StockAdjustmentStatus @default(DRAFT)

  adjustDate             DateTime @default(now())
  adjustedByNameSnapshot String?
  reason                 String?
  remarks                String?

  draftData    Json?
  draftVersion Int   @default(0)

  finalizedAt   DateTime?
  finalizedById String?
  createdById   String?
  updatedById   String?

  items StockAdjustmentItem[]

  @@unique([adjustFy, adjustNo])
  @@index([status])
  @@index([adjustFy])
  @@index([adjustDate])
  @@index([adjustedByNameSnapshot])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockAdjustmentId String
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  rawMaterialId    String?
  rawMaterial      RawMaterial?    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  title            String
  supplierItemName String?
  sku              String?
  typeNumber       String?
  hsnCode          String?
  unit             String?

  movementType StockMovementType
  qty          Decimal           @default(1) @db.Decimal(14, 3)
  unitCost     Decimal?          @db.Decimal(12, 2)

  remarks   String?
  sortOrder Int     @default(0)

  @@index([stockAdjustmentId, sortOrder])
  @@index([productVariantId])
  @@index([rawMaterialId])
  @@map("stock_adjustment_items")
}

model StockBalance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productVariantId String?         @unique
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  rawMaterialId    String?         @unique
  rawMaterial      RawMaterial?    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  castingMasterId  String?         @unique
  castingMaster    CastingMaster?  @relation(fields: [castingMasterId], references: [id], onDelete: Restrict)

  qtyOnHand    Decimal @default(0) @db.Decimal(14, 3)
  qtyReserved  Decimal @default(0) @db.Decimal(14, 3)
  qtyAvailable Decimal @default(0) @db.Decimal(14, 3)

  lastMovementAt DateTime?

  @@index([qtyOnHand])
  @@index([qtyAvailable])
  @@index([productVariantId])
  @@index([rawMaterialId])
  @@index([castingMasterId])
  @@map("stock_balances")
}

model StockLedger {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movementDate DateTime          @default(now())
  movementType StockMovementType

  referenceType StockReferenceType
  referenceId   String
  referenceNo   String?

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  rawMaterialId    String?
  rawMaterial      RawMaterial?    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  castingMasterId  String?
  castingMaster    CastingMaster?  @relation(fields: [castingMasterId], references: [id], onDelete: Restrict)

  qtyIn        Decimal @default(0) @db.Decimal(14, 3)
  qtyOut       Decimal @default(0) @db.Decimal(14, 3)
  balanceAfter Decimal @default(0) @db.Decimal(14, 3)

  unitCost  Decimal? @db.Decimal(12, 2)
  totalCost Decimal? @db.Decimal(14, 2)

  actorName   String?
  remarks     String?
  createdById String?

  @@index([productVariantId, movementDate])
  @@index([rawMaterialId, movementDate])
  @@index([castingMasterId, movementDate])
  @@index([referenceType, referenceId])
  @@index([movementType, movementDate])
  @@map("stock_ledger")
}

model WebsiteVisit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitedAt DateTime @default(now())

  visitorId String
  sessionId String

  isFrontend     Boolean @default(true)
  isSessionEntry Boolean @default(false)

  path        String
  queryString String?
  pageTitle   String?

  referrer   String?
  sourceHost String?
  sourceType WebsiteVisitSourceType @default(UNKNOWN)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  country       String?
  countryRegion String?
  city          String?

  deviceType WebsiteVisitDeviceType @default(OTHER)
  browser    String?
  os         String?
  userAgent  String?
  ipHash     String?

  @@index([visitedAt])
  @@index([visitorId, visitedAt])
  @@index([sessionId, visitedAt])
  @@index([sourceType, visitedAt])
  @@index([sourceHost, visitedAt])
  @@index([country, visitedAt])
  @@index([path, visitedAt])
  @@index([isFrontend, visitedAt])
  @@index([isSessionEntry, visitedAt])
