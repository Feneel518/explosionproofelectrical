  packingCharges        PackingCharges        @default(INCLUDED)
  paymentTerms          PaymentTerms          @default(ADVANCE)
  transportationPayment TransportationPayment @default(TO_PAY)
  discount              String?

  // Analytics totals
  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableTotal  Decimal @default(0) @db.Decimal(14, 2)
  gstTotal      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)

  // Analytics qty summaries
  totalItemsCount    Int @default(0)
  totalOrderedQty    Int @default(0)
  totalDispatchedQty Int @default(0)
  totalInvoicedQty   Int @default(0)
  totalPendingQty    Int @default(0)

  // Progress flags
  isConvertedFromQuotation Boolean @default(false)
  isClosed                 Boolean @default(false)
  isFullyDispatched        Boolean @default(false)
  isFullyInvoiced          Boolean @default(false)
  isOverdueForDispatch     Boolean @default(false)

  // Lifecycle dates
  convertedFromQuotationAt DateTime?
  confirmedAt              DateTime?
  productionStartedAt      DateTime?
  firstDispatchAt          DateTime?
  lastDispatchAt           DateTime?
  fullyDispatchedAt        DateTime?
  firstInvoicedAt          DateTime?
  fullyInvoicedAt          DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?

  orderVersion  Int       @default(1)
  lastAmendedAt DateTime?

  // Audit + soft delete
  createdById String?
  createdBy   User?   @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("SalesOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("SalesOrderDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Draft snapshot
  draftData    Json?
  draftVersion Int   @default(0)

  // Relations
  items            SalesOrderItem[]
  deliveryChallans DeliveryChallan[]
  invoices         Invoice[]

  @@unique([orderFy, orderNo])
  @@index([createdAt])
  @@index([status])
  @@index([sourceType])
  @@index([customerId])
  @@index([quotationId])
  @@index([orderFy])
  @@index([deletedAt])
  @@index([poNumber])
  @@index([orderDate])
  @@index([confirmedAt])
  @@index([completedAt])
  @@index([clientNameSnapshot])
  @@map("sales_orders")
}

