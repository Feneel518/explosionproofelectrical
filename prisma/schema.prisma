// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// enums
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum RawMaterialStatus {
  ACTIVE
  INACTIVE
}

enum CastingMasterStatus {
  ACTIVE
  INACTIVE
}

enum BomComponentType {
  RAW_MATERIAL
  CASTING
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductMediaKind {
  IMAGE
  DRAWING
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum QuotationStatus {
  DRAFT
  SENT
  FOLLOWUP
  WON
  LOST
  EXPIRED
  CANCELLED
}

enum LeadPlatform {
  WHATSAPP
  PHONE_CALL
  REDIFFMAIL
  INFO
  SALES1
  EECMINES
  WEBSITE
  INDIA_MART
  TRADE_INDIA
  DIRECT_VISIT
  REFERENCE
  OTHER
}

enum FollowupOutcome {
  NO_RESPONSE
  INTERESTED
  NEED_DISCOUNT
  NEED_REVISED_QUOTE
  POSTPONED
  LOST_TO_COMPETITOR
  WON
  OTHER
}

enum GST {
  IGST_18
  CGST_SGST_18
  IGST_0_SEZ
  CGST_SGST_0_SEZ
  IGST_5
  CGST_SGST_5
  IGST_12
  CGST_SGST_12
  IGST_28
  CGST_SGST_28
  IGST_0_1
  CGST_SGST_0_1
}

enum PackingCharges {
  INCLUDED
  EXCLUDED
}

enum PaymentTerms {
  ADVANCE
  AGAINST_PERFOMA_INVOICE
  AGAINST_DELIVERY
  CREDIT_30
  CREDIT_60
  CREDIT_45
}

enum TransportationPayment {
  PAID
  TO_PAY
}

//enums

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email         String  @unique
  emailVerified Boolean
  name          String?
  image         String?

  accounts                   Account[]
  sessions                   Session[]
  customerCreatedBy          Customer[]          @relation("CustomerCreatedBy")
  customerDeletedBy          Customer[]          @relation("CustomerDeletedBy")
  customerUpdatedBy          Customer[]          @relation("CustomerUpdatedBy")
  supplierCreatedBy          Supplier[]          @relation("SupplierCreatedBy")
  supplierDeletedBy          Supplier[]          @relation("SupplierDeletedBy")
  supplierUpdatedBy          Supplier[]          @relation("SupplierUpdatedBy")
  rawMaterialCreatedBy       RawMaterial[]       @relation("RawMaterialCreatedBy")
  rawMaterialDeletedBy       RawMaterial[]       @relation("RawMaterialDeletedBy")
  rawMaterialUpdatedBy       RawMaterial[]       @relation("RawMaterialUpdatedBy")
  categoriesCreatedBY        Category[]          @relation("CategoryCreatedBy")
  categoriesDeletedBy        Category[]          @relation("CategoryDeletedBy")
  categoriesUpdatedBY        Category[]          @relation("CategoryUpdatedBy")
  productDeletedBy           Product[]           @relation("ProductDeletedBy")
  quotationsCreatedBy        Quotation[]         @relation("QuotationCreatedBy")
  quotationsUpdatedBy        Quotation[]         @relation("QuotationUpdatedBy")
  quotationsDeletedBy        Quotation[]         @relation("QuotationDeletedBy")
  quotationFollowups         QuotationFollowup[] @relation("QuotationFollowupCreatedBy")
  deliveryChallanCreatedBy   DeliveryChallan[]   @relation("DeliveryChallanCreatedBy")
  deliveryChallanUpdatedBy   DeliveryChallan[]   @relation("DeliveryChallanUpdatedBy")
  deliveryChallanFinalizedBy DeliveryChallan[]   @relation("DeliveryChallanFinalizedBy")
  deliveryChallanClosedBy    DeliveryChallan[]   @relation("DeliveryChallanClosedBy")
  deliveryChallanDeletedBy   DeliveryChallan[]   @relation("DeliveryChallanDeletedBy")
  salesOrderCreatedBy        SalesOrder[]        @relation("SalesOrderCreatedBy")
  salesOrderUpdatedBy        SalesOrder[]        @relation("SalesOrderUpdatedBy")
  salesOrderDeletedBy        SalesOrder[]        @relation("SalesOrderDeletedBy")

  // Contractor work tracker audit relations
  workersCreatedBy              Worker[]              @relation("WorkerCreatedBy")
  workersUpdatedBy              Worker[]              @relation("WorkerUpdatedBy")
  workersDeletedBy              Worker[]              @relation("WorkerDeletedBy")
  contractorProductsCreatedBy   ContractorProduct[]   @relation("ContractorProductCreatedBy")
  contractorProductsUpdatedBy   ContractorProduct[]   @relation("ContractorProductUpdatedBy")
  contractorProductsDeletedBy   ContractorProduct[]   @relation("ContractorProductDeletedBy")
  contractorOperationsCreatedBy ContractorOperation[] @relation("ContractorOperationCreatedBy")
  contractorOperationsUpdatedBy ContractorOperation[] @relation("ContractorOperationUpdatedBy")
  contractorOperationsDeletedBy ContractorOperation[] @relation("ContractorOperationDeletedBy")
  contractorRatesCreatedBy      ContractorRate[]      @relation("ContractorRateCreatedBy")
  contractorRatesUpdatedBy      ContractorRate[]      @relation("ContractorRateUpdatedBy")
  contractorRatesDeletedBy      ContractorRate[]      @relation("ContractorRateDeletedBy")
  workEntriesCreatedBy          WorkEntry[]           @relation("WorkEntryCreatedBy")
  workEntriesUpdatedBy          WorkEntry[]           @relation("WorkEntryUpdatedBy")
  workEntriesDeletedBy          WorkEntry[]           @relation("WorkEntryDeletedBy")
  workerLedgerCreatedBy         WorkerLedgerEntry[]   @relation("WorkerLedgerCreatedBy")
  workerLedgerUpdatedBy         WorkerLedgerEntry[]   @relation("WorkerLedgerUpdatedBy")
  workerLedgerDeletedBy         WorkerLedgerEntry[]   @relation("WorkerLedgerDeletedBy")
  workerPayoutsCreatedBy        WorkerPayout[]        @relation("WorkerPayoutCreatedBy")
  workerPayoutsUpdatedBy        WorkerPayout[]        @relation("WorkerPayoutUpdatedBy")

  @@map("users")
}

model Account {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifier String
  value      String   @unique
  expiresAt  DateTime

  @@map("verifications")
}

// Customer
model Customer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName                           String
  companyEmail                          String?
  companyPhone                          String?
  addressLine1                          String
  addressLine2                          String?
  city                                  String
  state                                 String
  country                               String
  pincode                               String
  gstin                                 String?
  defaultQuotationGst                   GST                   @default(CGST_SGST_18)
  defaultQuotationPackingCharges        PackingCharges        @default(INCLUDED)
  defaultQuotationPaymentTerms          PaymentTerms          @default(ADVANCE)
  defaultQuotationTransportationPayment TransportationPayment @default(TO_PAY)
  defaultQuotationDeliveryDate          String?

  status CustomerStatus @default(ACTIVE)

  // soft delete
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("CustomerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // optional: who created / last updated
  createdById String?
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById          String?
  updatedBy            User?                 @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  newsletterSubscriber NewsletterSubscriber?
  quotations           Quotation[]
  deliveryChallans     DeliveryChallan[]
  salesOrders          SalesOrder[]
  invoices             Invoice[]

  @@index([companyName])
  @@index([companyPhone])
  @@index([companyEmail])
  @@index([gstin])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
}

// Supplier
model Supplier {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName  String
  companyEmail String?
  companyPhone String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  pincode      String
  gstin        String?

  status SupplierStatus @default(ACTIVE)

  // soft delete
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("SupplierDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // optional: who created / last updated
  createdById String?
  createdBy   User?   @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById       String?
  updatedBy         User?              @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  rawMaterials      RawMaterial[]
  goodsReceiptNotes GoodsReceiptNote[]
  castingJobs       CastingJob[]

  @@index([companyName])
  @@index([companyPhone])
  @@index([companyEmail])
  @@index([gstin])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
}

model RawMaterial {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyItemName      String
  supplierItemName     String?
  itemCode             String?   @unique
  hsnCode              String?
  unit                 String    @default("Nos")
  description          String?
  reorderLevel         Decimal?  @db.Decimal(14, 3)
  maximumStockLevel    Decimal?  @db.Decimal(14, 3)
  storageLocation      String?
  binNumber            String?
  openingStockQty      Decimal   @default(0) @db.Decimal(14, 3)
  openingStockUnitCost Decimal?  @db.Decimal(12, 2)
  openingStockAt       DateTime?

  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  status RawMaterialStatus @default(ACTIVE)

  // soft delete
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("RawMaterialDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // optional: who created / last updated
  createdById String?
  createdBy   User?   @relation("RawMaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("RawMaterialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  grnItems             GoodsReceiptNoteItem[]
  materialIssueItems   MaterialIssueItem[]
  castingInputItems    CastingJobItem[]       @relation("CastingInputRawMaterial")
  bomItems             VariantBomItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockBalance         StockBalance?
  stockLedgerEntries   StockLedger[]
  materialReturnItems  MaterialReturnItem[]

  @@index([companyItemName])
  @@index([supplierItemName])
  @@index([status])
  @@index([deletedAt])
  @@index([preferredSupplierId])
}

model CastingMaster {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castingItemName      String
  castingCode          String?   @unique
  drawingNumber        String?
  hsnCode              String?
  unit                 String    @default("Nos")
  standardWeightKg     Decimal?  @db.Decimal(12, 3)
  description          String?
  reorderLevel         Int?
  openingStockQty      Int       @default(0)
  openingStockUnitCost Decimal?  @db.Decimal(12, 2)
  openingStockAt       DateTime?

  status CastingMasterStatus @default(ACTIVE)

  deletedAt   DateTime?
  deletedById String?

  createdById String?

  updatedById String?

  castingJobItems    CastingJobItem[]
  bomItems           VariantBomItem[]
  stockBalance       StockBalance?
  stockLedgerEntries StockLedger[]

  @@index([castingItemName])
  @@index([status])
  @@index([deletedAt])
  @@map("casting_masters")
}

// Category
model Category {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  slug        String  @unique
  description String?

  status CategoryStatus @default(ACTIVE)

  // soft delete
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("CategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // optional: who created / last updated
  createdById String?
  createdBy   User?   @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  products Product[]

  @@index([status])
  @@index([name])
  @@map("categories")
}

// Product
model Product {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  name String // "FLP/WP Well Glass"
  slug String @unique

  flpType    String?
  protection String?
  gasGroup   String?
  material   String?
  finish     String?
  hardware   String?
  hsnCode    String?
  zones      String[] // Zone-1 & Zone-2

  // SEO / Website (safe to keep here; can be used later)
  shortDesc String?
  longDesc  String?

  // Relations
  variants ProductVariant[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Soft controls
  status ProductStatus @default(ACTIVE)

  // soft delete
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?            @relation("ProductDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]

  @@index([name, slug])
  @@index([categoryId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Identity
  variant    String
  sku        String? @unique
  typeNumber String?

  // Technical specs (variant-specific)
  rating     String? // "45W"
  terminals  String?
  gasket     String?
  mounting   String?
  cableEntry String?
  earthing   String? // ✅ fix spelling (was earting)

  // Dimensions / mechanical (optional, keep as String for flexibility)
  cutoutSize String?
  plateSize  String?
  size       String?
  glass      String?
  wireGuard  String?

  // Motor-related variants (optional)
  rpm        String?
  kW         String?
  horsePower String?

  // ✅ Media (ONLY in variant)
  images   ProductMedia[] @relation("VariantImages")
  drawings ProductMedia[] @relation("VariantDrawings")

  // ✅ Components (ONLY in variant)
  components ProductComponentsOnVariants[]
  bom        VariantBom?

  // General
  status               ProductStatus          @default(ACTIVE)
  quotationItems       QuotationItem[]
  deliveryChallanItems DeliveryChallanItem[]
  salesOrderItems      SalesOrderItem[]
  invoiceItems         InvoiceItem[]
  grnItems             GoodsReceiptNoteItem[]
  materialIssueItems   MaterialIssueItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockBalance         StockBalance?
  stockLedgerEntries   StockLedger[]

  @@unique([productId, variant])
  @@index([productId])
  @@index([variant])
}

model ProductMedia {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Two separate optional relations
  imageVariantId String?
  imageVariant   ProductVariant? @relation("VariantImages", fields: [imageVariantId], references: [id], onDelete: Cascade)

  drawingVariantId String?
  drawingVariant   ProductVariant? @relation("VariantDrawings", fields: [drawingVariantId], references: [id], onDelete: Cascade)

  kind          ProductMediaKind
  url           String
  title         String?
  sortOrder     Int              @default(0)
  salesOrder    SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  salesOrderId  String?
  invoiceItem   InvoiceItem?     @relation(fields: [invoiceItemId], references: [id])
  invoiceItemId String?
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id])
  invoiceId     String?

  @@index([kind])
  @@index([imageVariantId, sortOrder])
  @@index([drawingVariantId, sortOrder])
}

model ProductComponent {
  id   String  @id @default(uuid())
  item String
  unit String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductComponentsOnVariants[]
}

model ProductComponentsOnVariants {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  componentId String
  component   ProductComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([variantId, componentId])
  @@index([variantId])
  @@index([componentId])
}

// NewsKetter
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email  String           @unique
  name   String?
  status NewsletterStatus @default(SUBSCRIBED)

  // where it came from
  source     String? // "CUSTOMER", "FOOTER_FORM"
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // unsubscribe + compliance-friendly metadata
  unsubscribedAt DateTime?
  lastSentAt     DateTime?

  @@index([status])
  @@index([createdAt])
}

// Fiscal Counter
/**
 * /**
 * Example keys:
 * - "QUOTATION:FY2025-26"
 * - "ORDER:FY2025-26"
 */

model FiscalCounter {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key   String @unique
  value Int    @default(0)

  @@map("fiscal_counters")
}

model Quotation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Financial-year based numbering
  quoteNo Int
  quoteFy String // "FY2025-26"

  status   QuotationStatus @default(DRAFT)
  platform LeadPlatform    @default(OTHER)

  // Lead / enquiry context (works even without a Customer)
  receivedFromName  String?
  receivedFromPhone String?
  receivedFromEmail String?
  enquiryMessage    String?

  // Optional customer link
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientName String?

  // Follow-up helper fields (optional but useful for fast table rendering)
  // Keep these updated in code when followups change
  nextFollowupAt DateTime?
  lastFollowupAt DateTime?

  // Conversion to order (1 quote -> 0/1 order)
  convertedToOrderAt DateTime?
  // orderId            String? @unique
  // order              Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Audit + soft delete
  createdById String?
  createdBy   User?   @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("QuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("QuotationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // ✅ Draft snapshot (fast autosave)
  draftData    Json?
  draftVersion Int   @default(0)

  additionalNotes       String?
  gst                   GST
  packingCharges        PackingCharges        @default(INCLUDED)
  paymentTerms          PaymentTerms          @default(ADVANCE)
  transportationPayment TransportationPayment @default(TO_PAY)
  deliveryDate          String?

  discount String?

  // Relations
  items            QuotationItem[]
  followups        QuotationFollowup[]
  deliveryChallans DeliveryChallan[]
  salesOrders      SalesOrder[]

  @@unique([quoteFy, quoteNo])
  @@index([createdAt])
  @@index([status])
  @@index([platform])
  @@index([customerId])
  @@index([quoteFy])
  @@index([deletedAt])
  @@index([nextFollowupAt])
  @@map("quotations")
}

model QuotationItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  // Optional catalog links
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // ✅ Snapshot fields (always fill these)
  title       String // e.g. "FLP Well Glass - 45W - Variant A"
  sku         String?
  typeNumber  String?
  description String?
  rating      String?
  terminals   String?
  hardware    String?
  gasket      String?
  mounting    String?
  cableEntry  String?
  earthing    String?
  hsnCode     String?
  cutoutSize  String?
  plateSize   String?
  glass       String?
  wireGuard   String?
  variantType String?
  size        String?
  rpm         String?
  kW          String?
  horsePower  String?
  poReference String?

  showVariantImages   Boolean? @default(true)
  showVariantDrawings Boolean? @default(true)

  selectedVariantImageIds   String[]
  selectedVariantDrawingIds String[]

  variantImagesSnapshot   Json?
  variantDrawingsSnapshot Json?

  // Pricing
  qty       Int     @default(1)
  unit      String? // optional: "Nos", "Set"
  unitPrice Decimal @default(0) @db.Decimal(12, 2)

  ComponentsOfProductInQuotation ComponentsOfProductInQuotation[]

  sortOrder Int @default(0)

  @@index([quotationId, sortOrder])
  @@index([productId])
  @@index([variantId])
  @@map("quotation_items")
}

model ComponentsOfProductInQuotation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productInQuotationId String
  productInQuotation   QuotationItem @relation(fields: [productInQuotationId], references: [id])

  componentsOfQuotation   ComponentsOfQuotation @relation(fields: [componentsOfQuotationId], references: [id])
  componentsOfQuotationId String

  @@unique([productInQuotationId, componentsOfQuotationId])
  @@index([productInQuotationId])
  @@index([componentsOfQuotationId])
  @@map("quotation_item_components")
}

model ComponentsOfQuotation {
  id                             String                           @id @default(uuid())
  item                           String
  unit                           String?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  ComponentsOfProductInQuotation ComponentsOfProductInQuotation[]

  @@index([item])
}

model QuotationFollowup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  doneAt      DateTime?

  outcome FollowupOutcome?
  note    String?

  createdById String?
  createdBy   User?   @relation("QuotationFollowupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([scheduledAt])
  @@index([doneAt])
  @@map("quotation_followups")
}

/**
 * /**
 * Delivery Challan
 */

enum DeliveryChallanType {
  TO_BE_BILLED
  JOB_WORK
  SAMPLE
  RETURNABLE
}

enum DeliveryChallanStatus {
  DRAFT
  ISSUED
  PARTIALLY_CLOSED
  CLOSED
  CANCELLED
}

enum DeliveryChallanPartyType {
  CUSTOMER
  VENDOR
  OTHER
}

enum DeliveryChallanItemSourceType {
  PRODUCT
  RAW_MATERIAL
}

model DeliveryChallan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Financial-year based numbering
  challanNo   Int
  challanFy   String
  challanCode String @unique // ex: DC/25-26/0001

  type      DeliveryChallanType
  status    DeliveryChallanStatus    @default(DRAFT)
  partyType DeliveryChallanPartyType

  date        DateTime  @default(now())
  issuedAt    DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  expectedClosureDate DateTime?
  expectedReturnDate  DateTime?

  // optional PO ref
  poNumber String?

  // refs
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Dispatch / transport details
  transporterName  String?
  vehicleNumber    String?
  driverName       String?
