  rawMaterial      RawMaterial?    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  title      String
  supplierItemName String?
  sku        String?
  typeNumber String?
  hsnCode    String?
  unit       String?

  qty Int @default(1)

  unitCost  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @default(0) @db.Decimal(14, 2)
  sortOrder Int     @default(0)

  @@index([grnId, sortOrder])
  @@index([productVariantId])
  @@index([rawMaterialId])
  @@map("goods_receipt_note_items")
}

model MaterialIssue {
